#include<stdio.h>
#include<stdlib.h>
#define MAX 3
int queue[MAX];
int front=-1,rear=-1;
void insert(int val)
{
    if(rear==MAX-1)
    {
        printf("Queue Overload\n");
        return;
    }
    if(front==-1)
    front=0;
    rear++;
    queue[rear]=val;
    printf("Entered element: %d",val);
}
void delete()
{
    if(front==-1)
    {
        printf("Queue underflow\n");
        return;
    }
    printf("Deleted element: %d\n",queue[front++]);
    if(front>rear)
    front=rear=-1;
}
void display()
{
    if(rear==-1)
    {
        printf("Empty Queue\n");
        return;
    }
    int i;
    printf("Queue elements: ");
    for(i=front;i<=rear;i++)
    printf("%d ",queue[i]);
    printf("\n");
}
int main()
{
    int c,val;
    while(1)
    {
    printf("Enter:\n1.Insert\n2.Delete\n3.Display\n4.Quit :");
    scanf("%d",&c);
    switch(c)
    {
        case 1:
        printf("Enter value to be inserted: ");
        scanf("%d",&val);
        insert(val);
        break;
        case 2:
        delete();
        break;
        case 3:
        display();
        break;
        case 4:
        exit(0);
        default:
        printf("Invalid choice\n");
    }
    }
    return 0;

}
