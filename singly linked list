#include<stdio.h>
#include<stdlib.h>
#include<string.h>
typedef struct node
{
    char data[50];
    struct node *next;
}node;
node *start=NULL;
void insert(char *name)
{
    node *nn=(node *)malloc(sizeof(node));
    strcat(nn->data,name);
    nn->next=NULL;
    if(start==NULL||strcmp(start->data,name)>=0)
    {
        nn->next=start;
        start=nn;
    }
    else
    {
        node *cur=start,*prev=NULL;
        while(cur!=NULL)
        {
            if(strcmp(cur->data,name)>=0)
            {
                nn->next=cur;
                prev->next=nn;
                return;
            }
            prev=cur;
            cur=cur->next;
        }
    }
}
void delete(char *name)
{
    node *temp=start;
    if(temp!=NULL||strcmp(temp->data,name)==0)
    {
        start=temp->next;
        free(temp);
        return;
    }
    else
    {
        node *prev=NULL;
        while(temp!=NULL)
        {
            if(strcmp(temp->data,name)==0)
            {
                prev->next=temp->next;
                free(temp);
                break;
            }
            
            prev->next=temp;
            temp=temp->next;
        }
        printf("Name not found\n");
    }
}
void display()
{
    node *temp=start;
    while(temp!=NULL)
    {
        printf("%s ",temp->data);
        temp=temp->next;
    }
}
void main()
{
    char name[50];
    int ch;
    while(1)
    {
        printf("\n1.Insert\n2.Delete\n3.Display\n4.Exit\nEnter your choice: ");
		scanf("%d",&ch);
		switch(ch)
		{
			case 1:
			printf("Enter name to entered: ");
			scanf("%s",name);
			insert(name);
			break;
			case 2:
			printf("Enter name to be deleted: ");
			scanf("%s",name);
			delete(name);
			break;
			case 3:
			display();
			break;
			case 4:
			exit(0);
			default:
			printf("Inavalid choice\n");
		}
			
        
    }
    
}
